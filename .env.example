# Copy this file to .env.local and fill in your Gemini API key to enable
# live "Generate with Gemini" buttons throughout the app.
# Get a key from https://aistudio.google.com/apikey
#
# Without this, every generator still works: it assembles the exact prompt
# and gives you a "Copy prompt" button to paste into Gemini/Claude/ChatGPT
# yourself.
GEMINI_API_KEY=

# Optional — defaults to gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
